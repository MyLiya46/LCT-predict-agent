    { "label": "存储与派生" },
    { "label": "展示与聊天" }
  ],
  "nodes": [
    { "id": "workbench", "type": "frontend", "label": "工作台", "stage": 0, "row": 0, "tag": "UI", "width": 150 },
    { "id": "ai_chat", "type": "frontend", "label": "AI 聊天界面", "stage": 0, "row": 4, "tag": "AI" },
    { "id": "workbench_api", "type": "backend", "label": "Workbench API", "stage": 1, "row": 0, "tag": "read", "width": 128 },
    { "id": "ai_tools", "type": "backend", "label": "AI 内部工具", "stage": 1, "row": 4, "tag": "capabilities", "width": 164 },
    { "id": "icewash", "type": "external", "label": "Ice Wash Model", "stage": 2, "row": 1, "tag": "black box", "width": 140 },
    { "id": "model_relay", "type": "backend", "label": "PG Relay / Tasks", "stage": 2, "row": 3, "tag": "relay", "width": 150 },
    { "id": "data_store", "type": "database", "label": "PostgreSQL 数据层", "stage": 3, "row": 0, "tag": "source", "width": 180 },
    { "id": "result_projection", "type": "backend", "label": "结果与基线组装", "stage": 3, "row": 3, "tag": "derived", "width": 150 },
    { "id": "attribution_api", "type": "backend", "label": "归因独立 API", "stage": 3, "row": 4, "tag": "separate read", "width": 140 },
    { "id": "workbench_result", "type": "frontend", "label": "工作台结果", "stage": 4, "row": 3, "tag": "visible", "width": 140 },
