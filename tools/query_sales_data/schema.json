{
  "name": "query_sales_data",
  "description": "查询历史销售数据（支持 region/product/channel 维度，时间范围与筛选条件）",
  "input_schema": {
    "type": "object",
    "properties": {
      "dimensions": {"type": "array", "items": {"type": "string"}, "description": "维度列表，如 region/product/channel"},
      "time_range": {
        "type": "object",
        "properties": {"start": {"type": "string"}, "end": {"type": "string"}},
        "description": "时间范围（ISO 日期）"
      },
      "filters": {"type": "object", "additionalProperties": true}
    },
    "required": ["dimensions", "time_range"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "rows": {"type": "array"},
      "columns": {"type": "array", "items": {"type": "string"}},
      "query_time": {"type": "string"}
    }
  }
}