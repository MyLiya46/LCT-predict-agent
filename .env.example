# LCT-predict-agent production Compose environment.
# Copy this file to .env and replace every change-me value before deployment.
# Keep POSTGRES_PASSWORD URL-safe because Compose also builds the model PG URL.

# --- PostgreSQL ---
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres-2026
POSTGRES_DB=agent_platform

# --- application secrets ---
JWT_SECRET=change-me-jwt-secret-change-me-jwt-secret-2026
API_INTERNAL_TOKEN=change-me-internal-token-2026
ADMIN_INITIAL_EMAIL=admin@corp.com
ADMIN_INITIAL_PASSWORD=change-me-admin-password-2026

# --- LLM bootstrap (optional; leave all three empty to configure in Admin) ---
LLM_API_KEYS=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=

# --- service/runtime settings ---
NGINX_PORT=80
API_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1
WHITELIST_CIDRS=10.0.0.0/8,192.168.0.0/16
SANDBOX_TIMEOUT_S=30
DOCKER_CLI_IMAGE=docker:cli
WORKBENCH_SYNC_ON_STARTUP=true
FORECAST_MODEL_ENABLED=true
FORECAST_POLL_INTERVAL_SEC=5.0
FORECAST_POLL_TIMEOUT_SEC=3600.0
