# ============ LCT-predict-agent · backend 本地开发环境变量样例 ============
# 复制为 .env 后填写；.env 不入版本库（.gitignore 已忽略），本示例入库供他人参考。
# 配置按当前 backend/src/app/config.py（Settings）及业务代码实际使用情况整理；
# 生产部署走根目录 docker-compose 的 .env，与本文件无关。

# --- 应用名称（unused） ---
APP_NAME=预测智能体
# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/agent_platform

# --- JWT 认证与初始化管理员 ---
# HS256 密钥，>=32 字节：openssl rand -base64 32
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32
# 首启种子管理员账号（见 seed.v1__base_seed）
ADMIN_INITIAL_EMAIL=admin@corp.com
ADMIN_INITIAL_PASSWORD=LctDevAdmin_2026!

# --- 沙箱服务 ---
API_INTERNAL_TOKEN=change_me_internal_token
SANDBOX_DAEMON_URL=http://127.0.0.1:9000

# --- LLM Provider 首次引导 ---
# seed 首建 provider 用：LLM_API_KEYS 取首个 key，LLM_BASE_URL/LLM_DEFAULT_MODEL 提供地址与模型；
# 三者齐备时幂等建一条 env-default 供应商；已在管理端配置过则跳过。
LLM_API_KEYS=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=

# --- 内网数据服务 ---
INTERNAL_TOKEN=

# --- 沙箱网络白名单 ---
WHITELIST_CIDRS=10.0.0.0/8,192.168.0.0/16

# --- 沙箱运行参数 ---
SANDBOX_TIMEOUT_S=30
# --- 日志级别（unused） ---
LOG_LEVEL=INFO
# --- 后端对外地址（unused） ---
API_BASE_URL=http://127.0.0.1:8000
# --- 冰洗服务地址 ---
ICEWASH_BASE_URL=http://127.0.0.1:8001
# --- Workbench 启动同步 ---
WORKBENCH_SYNC_ON_STARTUP=false

# --- Agent Chat 网关（unused） ---
AGENT_MODE=mock
AGENT_API_URL=https://ml-api-gw-en.tcl.com/agi/v1/chat-messages
AGENT_API_KEY=
AGENT_NEW_TOKEN=
AGENT_TCL_TOKEN=
AGENT_TCL_TOKEN_HEADER=TCLTOKEN
AGENT_JWT_TOKEN=
AGENT_RESPONSE_MODE=blocking
AGENT_USER=forecast-agent-ui
AGENT_USER_ID=
AGENT_USER_NAME=
AGENT_OA=
AGENT_TIMEOUT_SEC=120.0
AGENT_ENABLE_THINKING=
AGENT_ATTACHMENT=
AGENT_EXTRA_INPUTS_JSON=

# --- Turing 分析增强（unused） ---
ANALYSIS_AGENT_ENABLED=true
TURING_API_BASE=https://live-turing.cn.llm.tcljd.com/api/v1
TURING_API_KEY=
TURING_MODEL=turing/gpt-5.4-mini
TURING_TIMEOUT_SEC=90.0

# --- OAuth 登录 ---
OAUTH_BASE_URL=https://aigc-gateway.tcl.com
OAUTH_TOKEN_PATH=/oauth/oauth/token
OAUTH_GRANT_TYPE=username
OAUTH_CLIENT_ID=ai-client
OAUTH_CLIENT_SECRET=secret
OAUTH_SOURCE_TYPE=app
OAUTH_USER_TYPE=P
OAUTH_LOGIN_FIELD=username
OAUTH_DEVICE_ID=
# --- OAuth 密码配置（unused） ---
OAUTH_PASSWORD=

# --- 意图识别 / 任务规划（unused） ---
PLANNER_ENABLED=true
PLANNER_MAX_STEPS=4
PLANNER_TIMEOUT_SEC=12.0

# --- 多层记忆（unused） ---
MEMORY_ENABLED=true
MEMORY_SHORT_TURNS=8
MEMORY_SUMMARY_EVERY_TURNS=4
MEMORY_SUMMARY_CHAR_THRESHOLD=2400
MEMORY_RETRIEVE_K=3
MEMORY_CHUNK_MAX_CHARS=500
# --- Turing Embedding（unused） ---
TURING_EMBED_MODEL=turing/text-embedding
TURING_EMBED_TIMEOUT_SEC=12.0

# --- MCP 配置（unused） ---
MCP_MODE=
MCP_URL=
MCP_TIMEOUT_SEC=0.0

# --- 冰洗预测模型异步 API ---
FORECAST_MODEL_ENABLED=true
FORECAST_MODEL_BASE_URL=http://127.0.0.1:8001
# 模型进程写 Excel 的目录（与 cbg_fcst_month server 的 cwd 一致）
FORECAST_MODEL_OUTPUT_DIR=
FORECAST_POLL_INTERVAL_SEC=5.0
FORECAST_POLL_TIMEOUT_SEC=3600.0
FORECAST_DEFAULT_PRODUCT_LINE=PL003
FORECAST_REPORTER=forecast-agent
# JSON: {"冰箱":{"priceBatchNumber":"...","productBatchNumber":"..."}, ...}
FORECAST_CATEGORY_BATCH_MAP_JSON={"冰箱":{"priceBatchNumber":"JG_PL003_20260615_001","productBatchNumber":"SX_PL003_20260615_004"},"洗衣机":{"priceBatchNumber":"JG_PL003_20260624_001","productBatchNumber":"SX_PL003_20260609_006"}}

# --- 跨域配置 ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
