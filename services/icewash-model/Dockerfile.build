FROM python:3.10-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY cbg_fcst_month/requirements.txt ./cbg_fcst_month/requirements.txt
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ -r cbg_fcst_month/requirements.txt
COPY cbg_fcst_month/ ./cbg_fcst_month/
COPY data/ ./data/
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
WORKDIR /app/cbg_fcst_month
CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8000"]
